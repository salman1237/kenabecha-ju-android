<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only manifest overlay, merged only into debug builds — points at
     the network security config that allows cleartext to localhost, so a
     release build never references (or packages) either. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
